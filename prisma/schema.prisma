generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum GapStatus {
  TODO
  IN_PROGRESS
  DONE
  SKIPPED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logs      DailyLog[]
}

model GapItem {
  id          String    @id
  title       String
  description String
  category    String
  status      GapStatus @default(TODO)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  logs        DailyLog[]
}

model DailyLog {
  id          String   @id @default(uuid())
  gapItemId   String
  description String
  hours       Float    @default(1.0)
  loggedAt    DateTime @default(now())
  userId      String?
  gapItem     GapItem  @relation(fields: [gapItemId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])
}

model DropshipMilestone {
  id          String   @id
  month       String
  focus       String
  targetMetric String
  status      GapStatus @default(TODO)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReadingNote {
  id        String   @id @default(uuid())
  title     String
  topic     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model dropship_phase_contents {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id        String            @db.Uuid
  phase_id          String
  content           String?           @default("")
  done              Boolean?          @default(false)
  updated_at        DateTime          @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  dropship_products dropship_products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, phase_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model dropship_products {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  cost_price              Decimal?                  @default(0.00) @db.Decimal(10, 2)
  selling_price           Decimal?                  @default(0.00) @db.Decimal(10, 2)
  criteria                Json?                     @default("{}")
  project_folder          String?
  created_at              DateTime                  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at              DateTime                  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  dropship_phase_contents dropship_phase_contents[]
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model stock {
  date                DateTime? @db.Timestamptz(6)
  symbol              String
  priceOpen           Float?
  priceHigh           Float?
  priceLow            Float?
  priceClose          Float?
  priceBasic          Float?
  totalVolume         Float?
  dealVolume          Float?
  putthroughVolume    Float?
  totalValue          Float?
  buyForeignQuantity  Float?
  sellForeignQuantity Float?
  adjRatio            Float?
  unit                Float?

  @@unique([symbol, date], map: "unique_symbol_date")
  @@ignore
}

model stock_sync_logs {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sync_date       DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  status          String    @db.VarChar(20)
  records_synced  Int?      @default(0)
  error_message   String?
  run_duration_ms Int?
  created_at      DateTime? @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "idx_stock_sync_logs_created_at")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tech_knowledge {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug       String    @unique
  title      String
  content    String
  type       String?   @default("Article")
  level      String?   @default("Fundamental")
  date       DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  tags       String[]  @default([])
}
